############################################
# KUMSS Production .htaccess
# Clean URLs + SEO + Security + Performance
############################################

Options -Indexes

RewriteEngine On

############################################
# Redirect old vision-mission URL
############################################

RewriteRule ^vision-mission(\.html)?/?$ /ajit-career-academy [R=301,L]

############################################
# 1. Force HTTPS
############################################

RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

############################################
# 2. Remove .html extension from URLs
############################################

RewriteCond %{THE_REQUEST} \s([^.]+)\.html [NC]
RewriteRule ^ %1 [R=301,L]

############################################
# 3. Internally serve .html when extension missing
############################################

RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

############################################
# 4. Remove trailing slash from files
############################################

RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

############################################
# 5. Cache Control (Performance Boost)
############################################

<IfModule mod_expires.c>

ExpiresActive On

ExpiresByType image/jpg "access 1 year"
ExpiresByType image/jpeg "access 1 year"
ExpiresByType image/png "access 1 year"
ExpiresByType image/webp "access 1 year"
ExpiresByType image/svg+xml "access 1 year"

ExpiresByType text/css "access 1 month"
ExpiresByType application/javascript "access 1 month"

ExpiresByType text/html "access 1 hour"

</IfModule>

############################################
# 6. Enable Compression (Speed Boost)
############################################

<IfModule mod_deflate.c>

AddOutputFilterByType DEFLATE text/plain
AddOutputFilterByType DEFLATE text/html
AddOutputFilterByType DEFLATE text/xml
AddOutputFilterByType DEFLATE text/css
AddOutputFilterByType DEFLATE application/javascript
AddOutputFilterByType DEFLATE application/json

</IfModule>

############################################
# 7. Security Headers
############################################

<IfModule mod_headers.c>

Header set X-Content-Type-Options "nosniff"
Header set X-XSS-Protection "1; mode=block"
Header set X-Frame-Options "SAMEORIGIN"
Header set Referrer-Policy "strict-origin-when-cross-origin"

</IfModule>

############################################
# 8. Block Hidden Files
############################################

<FilesMatch "^\.">
Order allow,deny
Deny from all
</FilesMatch>

############################################
# 9. Protect Sensitive Files
############################################

<FilesMatch "(^#.*#|\.(bak|config|dist|log|sql|sh))$">
Order allow,deny
Deny from all
</FilesMatch>

############################################
# 10. Default index
############################################

DirectoryIndex index.html